     "relatedQuantityIds": [
      "u1"
     ]
    },
    {
     "id": "c5",
     "claim": "Take square roots of both sides, including both signs.",
     "expected": "x + b/(2a) = ±sqrt(b^2 - 4ac)/(2a)",
     "relatedQuantityIds": [
      "u1"
     ]
    },
    {
     "id": "c6",
     "claim": "Isolate x to obtain the quadratic formula.",
     "expected": "x = (-b ± sqrt(b^2 - 4ac))/(2a)",
     "relatedQuantityIds": [
