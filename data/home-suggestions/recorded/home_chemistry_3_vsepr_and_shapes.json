   "qualitativeClaims": [
    {
     "id": "c1",
     "claim": "VSEPR theory: electron pairs in the valence shell of a central atom repel each other and arrange themselves as far apart as possible; lone pairs repel more strongly than bonding pairs (LP-LP > LP-BP > BP-BP), so molecular shape is set by the positions of atoms after minimizing repulsion.",
     "expected": "Electron-pair geometry from total steric number; molecular shape from bonding pairs only; lone pairs compress bond angles.",
     "relatedEntityHints": [
      "valence electron pairs",
      "lone pairs",
      "bonding pairs"
     ]
    },
    {
     "id": "c2",
     "claim": "SF4: sulfur has 6 valence electrons; 4 bonding pairs to F plus 1 lone pair gives steric number 5, a trigonal-bipyramidal electron geometry.",
     "expected": "Steric number = (6 + 4)/2 = 5; electron geometry trigonal bipyramidal.",
     "relatedEntityHints": [
      "SF4",
      "sulfur",
      "fluorine"
     ]
    },
    {
     "id": "c3",
     "claim": "In SF4 the lone pair occupies an equatorial position (fewer 90-degree repulsions than axial), leaving the four F atoms in a seesaw (sawhorse) molecular shape.",
     "expected": "Shape: seesaw; equatorial lone pair; axial F-S-F slightly less than 180 degrees, equatorial F-S-F slightly less than 120 degrees due to lone-pair repulsion.",
     "relatedEntityHints": [
      "SF4",
      "seesaw shape"
     ]
    },
    {
     "id": "c4",
     "claim": "XeF4: xenon has 8 valence electrons; 4 bonding pairs to F plus 2 lone pairs gives steric number 6, an octahedral electron geometry.",
     "expected": "Steric number = (8 + 4)/2 = 6; electron geometry octahedral.",
     "relatedEntityHints": [
      "XeF4",
      "xenon",
      "fluorine"
     ]
    },
    {
     "id": "c5",
     "claim": "In XeF4 the two lone pairs occupy opposite (trans, axial) positions to maximize separation, leaving the four F atoms in one plane: square planar molecular shape with 90-degree F-Xe-F angles.",
     "expected": "Shape: square planar; lone pairs trans; F-Xe-F = 90 degrees.",
     "relatedEntityHints": [
      "XeF4",
      "square planar"
     ]
    },
    {
     "id": "c6",
     "claim": "Comparison: both have four bonding pairs, but SF4 (1 lone pair) is seesaw while XeF4 (2 lone pairs) is square planar, showing how lone-pair count controls shape.",
     "expected": "Same ligand count, different steric numbers (5 vs 6) give different shapes.",
     "relatedEntityHints": [
      "SF4",
      "XeF4"
     ]
    }
   ],
   "lawIds": [
    "VSEPR theory",
    "steric number = (valence electrons of central atom + monovalent atoms)/2",
    "lone pair-bond pair repulsion hierarchy"
   ],
   "assumptions": [
    "Sulfur and xenon are hypervalent here; octet expansion is treated descriptively via VSEPR steric counting.",
    "Fluorine is monovalent and contributes one electron per bond in steric counting.",
    "Idealized geometries; real bond angles are slightly compressed by lone pairs."
   ],
