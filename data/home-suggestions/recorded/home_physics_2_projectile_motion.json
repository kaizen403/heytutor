   "qualitativeClaims": [
    {
     "id": "c1",
     "claim": "Resolve initial velocity: horizontal component uₓ = u cosθ, vertical component u_y = u sinθ.",
     "expected": "uₓ = u cosθ; u_y = u sinθ",
     "relatedQuantityIds": [
      "R"
     ]
    },
    {
     "id": "c2",
     "claim": "Vertical motion under gravity: time of flight from 0 = u sinθ·T − ½gT², giving T = 2u sinθ/g.",
     "expected": "T = 2u sinθ / g",
     "relatedQuantityIds": [
      "R"
     ]
    },
    {
     "id": "c3",
     "claim": "Horizontal motion at constant velocity: R = u cosθ · T = u cosθ · 2u sinθ/g.",
     "expected": "R = (2u² sinθ cosθ)/g",
     "relatedQuantityIds": [
      "R"
     ]
    },
    {
     "id": "c4",
     "claim": "Apply double-angle identity 2 sinθ cosθ = sin2θ to obtain the range formula.",
     "expected": "R = u² sin(2θ) / g",
     "relatedQuantityIds": [
      "R",
      "thetaMax"
     ]
    },
    {
     "id": "c5",
     "claim": "For fixed u and g, R is maximised when sin(2θ) is maximised; maximum value of sine is 1 at 2θ = 90°, so θ = 45°.",
     "expected": "R_max = u²/g at θ_max = 45°",
     "relatedQuantityIds": [
      "R",
      "thetaMax"
     ]
    },
    {
     "id": "c6",
     "claim": "Calculus check: dR/dθ = (2u²/g)cos(2θ) = 0 gives θ = 45°, and d²R/dθ² = −(4u²/g)sin(2θ) < 0 there, confirming a maximum.",
     "expected": "dR/dθ = 0 at θ = 45°; second derivative negative",
     "relatedQuantityIds": [
      "thetaMax"
     ]
    }
   ],
