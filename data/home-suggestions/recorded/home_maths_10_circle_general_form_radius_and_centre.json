   "qualitativeClaims": [
    {
     "id": "c1",
     "claim": "A circle is the set of points at a fixed distance (radius r) from a fixed point (centre (h,k)), giving the standard equation (x-h)^2+(y-k)^2=r^2.",
     "expected": "(x-h)^2+(y-k)^2=r^2",
     "relatedEntityHints": [
      "circle",
      "centre",
      "radius"
     ]
    },
    {
     "id": "c2",
     "claim": "A general equation x^2+y^2+Dx+Ey+F=0 hides the centre and radius because the x and y terms are mixed with linear terms.",
     "expected": "x^2+y^2+Dx+Ey+F=0",
     "relatedEntityHints": [
      "general form"
     ]
    },
    {
     "id": "c3",
     "claim": "Completing the square rewrites x^2+Dx as (x+D/2)^2-(D/2)^2, and similarly y^2+Ey as (y+E/2)^2-(E/2)^2, converting each variable into a perfect-square shift.",
     "expected": "x^2+Dx=(x+D/2)^2-(D/2)^2; y^2+Ey=(y+E/2)^2-(E/2)^2",
     "relatedEntityHints": [
      "completing the square"
     ]
    },
    {
     "id": "c4",
     "claim": "Substituting and moving constants to the right yields (x+D/2)^2+(y+E/2)^2=(D/2)^2+(E/2)^2-F, which matches the standard form.",
     "expected": "(x+D/2)^2+(y+E/2)^2=D^2/4+E^2/4-F",
     "relatedEntityHints": [
      "standard form"
     ]
    },
    {
     "id": "c5",
     "claim": "Matching with (x-h)^2+(y-k)^2=r^2 reads off the centre directly: h=-D/2, k=-E/2, so the centre is (-D/2,-E/2).",
     "expected": "centre (h,k)=(-D/2,-E/2)",
     "relatedEntityHints": [
      "centre"
     ]
    },
    {
     "id": "c6",
     "claim": "The right-hand side is r^2, so the radius is r=sqrt(D^2/4+E^2/4-F), requiring D^2/4+E^2/4-F>0 for a real circle.",
     "expected": "r=sqrt(D^2+E^2-4F)/2",
     "relatedEntityHints": [
      "radius"
     ]
    },
    {
     "id": "c7",
     "claim": "Geometrically, completing the square is a translation of coordinates: it recentres the equation at the circle's true centre, making the squared-distance structure (and hence the radius) explicit.",
     "expected": "translation to centre makes distance structure explicit",
     "relatedEntityHints": [
      "interpretation"
     ]
    }
   ],
