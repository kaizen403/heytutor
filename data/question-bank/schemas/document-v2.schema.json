{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heytutor.local/schemas/question-bank/document-v2.schema.json",
  "title": "Question bank source document with paper and archive provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "provenance",
    "year",
    "exam",
    "session",
    "set",
    "subject",
    "source_url",
    "paper",
    "artifact",
    "sha256",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "question-bank-document/v2" },
    "document_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "source_type", "retrieved_at", "notes"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": ["official", "institutional_archive", "public_archive", "third_party", "unknown"]
        },
        "retrieved_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "exam": { "type": "string", "minLength": 1 },
    "session": { "type": "string", "minLength": 1 },
    "set": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "paper_number",
        "exam_date",
        "shift",
        "mode",
        "language",
        "accessibility_variant"
      ],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "paper_number": { "type": ["string", "null"], "minLength": 1 },
        "exam_date": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          ]
        },
        "shift": { "type": ["string", "null"], "minLength": 1 },
        "mode": { "enum": ["offline", "computer_based", "unknown"] },
        "language": { "type": "string", "minLength": 1 },
        "accessibility_variant": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "page_count",
        "container_url",
        "container_sha256",
        "member_path"
      ],
      "properties": {
        "media_type": { "type": "string", "minLength": 1 },
        "page_count": { "type": ["integer", "null"], "minimum": 1 },
        "container_url": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "uri", "pattern": "^https://" }
          ]
        },
        "container_sha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "member_path": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "status": { "enum": ["planned", "acquired", "extracted", "reviewed", "failed"] }
  }
}
