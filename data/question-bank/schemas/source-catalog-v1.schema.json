{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heytutor.local/schemas/question-bank/source-catalog-v1.schema.json",
  "title": "Verified exam artifact source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "scope", "artifacts", "known_gaps"],
  "properties": {
    "schema_version": { "const": "question-bank-source-catalog/v1" },
    "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mathematics", "physics"],
      "properties": {
        "mathematics": { "type": "string", "minLength": 1 },
        "physics": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "known_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "local_name",
        "publisher",
        "source_type",
        "exam",
        "year",
        "session",
        "set",
        "subject",
        "url",
        "language",
        "accessibility_variant",
        "stage",
        "paper_number",
        "mode"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "kind": { "enum": ["pdf", "zip"] },
        "local_name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": [
            "official",
            "institutional_archive",
            "public_archive",
            "third_party",
            "unknown"
          ]
        },
        "exam": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "session": { "type": "string", "minLength": 1 },
        "set": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "language": { "type": "string", "minLength": 1 },
        "accessibility_variant": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "paper_number": { "type": ["string", "null"], "minLength": 1 },
        "mode": { "enum": ["offline", "computer_based", "unknown"] },
        "exam_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "shift": { "type": "string", "minLength": 1 }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "years", "status", "notes"],
      "properties": {
        "collection": { "type": "string", "minLength": 1 },
        "years": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
