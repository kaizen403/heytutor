{
  "$id": "https://heytutor.local/schemas/question-bank/nta-jee-main-official-schedule-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NTA JEE Main Official Schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "program", "sessions"],
  "properties": {
    "schema_version": { "const": "nta-jee-main-official-schedule/v1" },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "program": { "type": "string", "minLength": 1 },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternate_source_urls",
          "keys",
          "label",
          "session_id",
          "source_url",
          "year"
        ],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "year": { "type": "integer", "minimum": 2020, "maximum": 2026 },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "alternate_source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "uniqueItems": true
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_type",
                "exam_date",
                "expected_gap",
                "shift"
              ],
              "properties": {
                "exam_date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "shift": {
                  "type": "integer",
                  "enum": [1, 2]
                },
                "evidence_type": { "type": "string", "minLength": 1 },
                "expected_gap": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
