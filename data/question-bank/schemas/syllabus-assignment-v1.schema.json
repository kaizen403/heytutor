{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heytutor.local/schemas/question-bank/syllabus-assignment-v1.schema.json",
  "title": "Deterministic syllabus assignment sidecar for a canonical question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "framework_id",
    "subject",
    "subject_status",
    "status",
    "primary_unit_id",
    "primary_topic_id",
    "confidence",
    "score",
    "margin",
    "syllabus_scope",
    "method",
    "candidate_units",
    "matched_topic_ids",
    "review_reasons"
  ],
  "properties": {
    "schema_version": { "const": "question-bank-syllabus-assignment/v1" },
    "question_id": { "type": "string", "pattern": "^q_[0-9a-f]{64}$" },
    "framework_id": { "type": "string", "minLength": 1 },
    "subject": { "enum": ["Mathematics", "Physics", "Chemistry", null] },
    "subject_status": {
      "enum": ["resolved", "missing_context", "conflict", "out_of_scope"]
    },
    "status": { "enum": ["classified", "needs_review", "out_of_scope"] },
    "primary_unit_id": { "type": ["string", "null"], "minLength": 1 },
    "primary_topic_id": { "type": ["string", "null"], "minLength": 1 },
    "confidence": { "enum": ["high", "medium", null] },
    "score": { "type": ["integer", "null"] },
    "margin": { "type": ["integer", "null"] },
    "syllabus_scope": {
      "enum": [
        "active",
        "outside_active_syllabus",
        "undetermined",
        "out_of_scope"
      ]
    },
    "method": { "const": "deterministic-lexical/v1" },
    "candidate_units": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "matched_topic_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "review_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "weight"],
      "properties": {
        "kind": {
          "enum": [
            "existing_topic_projection",
            "strong_phrase",
            "supporting_phrase",
            "pattern",
            "supplemental_alias",
            "exclusion"
          ]
        },
        "value": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "existing_topic_projection" },
            "weight": { "const": 20 }
          }
        },
        {
          "properties": {
            "kind": { "const": "strong_phrase" },
            "weight": { "const": 8 }
          }
        },
        {
          "properties": {
            "kind": { "const": "supporting_phrase" },
            "weight": { "const": 3 }
          }
        },
        {
          "properties": {
            "kind": { "const": "pattern" },
            "weight": { "const": 5 }
          }
        },
        {
          "properties": {
            "kind": { "const": "supplemental_alias" },
            "weight": { "const": 8 }
          }
        },
        {
          "properties": {
            "kind": { "const": "exclusion" },
            "weight": { "const": -8 }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "score", "evidence"],
      "properties": {
        "unit_id": { "type": "string", "minLength": 1 },
        "score": { "type": "integer" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
