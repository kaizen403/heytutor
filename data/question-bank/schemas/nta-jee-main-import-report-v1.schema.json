{
  "$id": "https://heytutor.local/schemas/question-bank/nta-jee-main-import-report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NTA JEE Main Import Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acquisition_report_path",
    "allow_regional_fallback",
    "by_year",
    "copied_raw_document_ids",
    "imported_document_ids",
    "manifest_path",
    "missing_schedule_keys",
    "notes",
    "operation",
    "raw_dir",
    "reused_manifest_document_ids",
    "reused_raw_document_ids",
    "schema_version",
    "source_release_status",
    "staging_dir",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "nta-jee-main-import-report/v1" },
    "operation": { "const": "import-nta-jee-main" },
    "source_release_status": { "const": "candidate_only" },
    "acquisition_report_path": { "type": "string", "minLength": 1 },
    "staging_dir": { "type": "string", "minLength": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "raw_dir": { "type": "string", "minLength": 1 },
    "allow_regional_fallback": { "type": "boolean" },
    "imported_document_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reused_manifest_document_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "copied_raw_document_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reused_raw_document_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_schedule_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternate_source_urls",
          "evidence_type",
          "exam_date",
          "expected_gap",
          "official_key",
          "session_id",
          "session_label",
          "shift",
          "source_url",
          "year"
        ],
        "properties": {
          "official_key": { "type": "string", "minLength": 1 },
          "exam_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "shift": { "type": "integer", "enum": [1, 2] },
          "evidence_type": { "type": "string", "minLength": 1 },
          "expected_gap": { "type": "boolean" },
          "session_id": { "type": "string", "minLength": 1 },
          "session_label": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri" },
          "alternate_source_urls": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "year": { "type": "integer", "minimum": 2020, "maximum": 2026 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_candidates",
        "copied_raw_documents",
        "imported_documents",
        "missing_schedule_keys",
        "reused_manifest_documents",
        "reused_raw_documents"
      ],
      "properties": {
        "canonical_candidates": { "type": "integer", "minimum": 0 },
        "imported_documents": { "type": "integer", "minimum": 0 },
        "reused_manifest_documents": { "type": "integer", "minimum": 0 },
        "copied_raw_documents": { "type": "integer", "minimum": 0 },
        "reused_raw_documents": { "type": "integer", "minimum": 0 },
        "missing_schedule_keys": { "type": "integer", "minimum": 0 }
      }
    },
    "by_year": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
