{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heytutor.local/schemas/question-bank/document-v1.schema.json",
  "title": "Question bank source document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "provenance",
    "year",
    "exam",
    "session",
    "set",
    "subject",
    "source_url",
    "sha256",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "question-bank-document/v1" },
    "document_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "source_type", "retrieved_at", "notes"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": ["official", "institutional_archive", "public_archive", "third_party", "unknown"]
        },
        "retrieved_at": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "exam": { "type": "string", "minLength": 1 },
    "session": { "type": "string", "minLength": 1 },
    "set": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "status": { "enum": ["planned", "acquired", "extracted", "reviewed", "failed"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["acquired", "extracted", "reviewed"] } } },
      "then": { "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
    }
  ]
}
