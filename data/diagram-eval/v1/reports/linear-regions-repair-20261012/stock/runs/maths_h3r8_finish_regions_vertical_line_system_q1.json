    "rawContent": "{\n  \"schemaVersion\": \"scene-document/v2\",\n  \"visualDecision\": {\n    \"mode\": \"scene\",\n    \"reason\": \"The given equations and exact derived values determine both lines and their intersection.\"\n  },\n  \"source\": {\n    \"question\": \"Graph the real simultaneous system L1: 4x + 3 = 2x + 8 and L2: 2y - x = 7. Label both lines with equivalent simplified equations, their intercepts where they exist, and the exact intersection P. Explain from the figure how many solutions there are.\"\n  },\n  \"quantities\": [\n    {\"id\":\"a\",\"value\":4},\n    {\"id\":\"b\",\"value\":3},\n    {\"id\":\"c\",\"value\":2},\n    {\"id\":\"d\",\"value\":8},\n    {\"id\":\"e\",\"value\":2},\n    {\"id\":\"f\",\"value\":7},\n    {\"id\":\"px\",\"value\":2.5},\n    {\"id\":\"py\",\"value\":4.75},\n    {\"id\":\"l1xi\",\"value\":2.5},\n    {\"id\":\"l2xi\",\"value\":-7},\n    {\"id\":\"l2yi\",\"value\":3.5},\n    {\"id\":\"n\",\"value\":1}\n  ],\n  \"entities\": [\n    {\"id\":\"ax\",\"kind\":\"axes\",\"role\":\"coordinate axes\"},\n    {\"id\":\"I1\",\"kind\":\"point\",\"role\":\"L1 x-intercept\"},\n    {\"id\":\"I2x\",\"kind\":\"point\",\"role\":\"L2 x-intercept\"},\n    {\"id\":\"I2y\",\"kind\":\"point\",\"role\":\"L2 y-intercept\"},\n    {\"id\":\"L1\",\"kind\":\"line\",\"role\":\"4x + 3 = 2x + 8\"},\n    {\"id\":\"L2\",\"kind\":\"line\",\"role\":\"2y - x = 7\"},\n    {\"id\":\"P\",\"kind\":\"point\",\"role\":\"intersection and solution\"}\n  ],\n  \"constructions\": [\n    {\"id\":\"kax\",\"operator\":\"axes\",\"inputs\":{\"xMin\":-8,\"xMax\":5,\"yMin\":-1,\"yMax\":7},\"outputs\":[\"ax\"]},\n    {\"id\":\"kI1\",\"operator\":\"point\",\"inputs\":{\"x\":2.5,\"y\":0,\"coordinateSpace\":\"world\"},\"outputs\":[\"I1\"]},\n    {\"id\":\"kI2x\",\"operator\":\"point\",\"inputs\":{\"x\":-7,\"y\":0,\"coordinateSpace\":\"world\"},\"outputs\":[\"I2x\"]},\n    {\"id\":\"kI2y\",\"operator\":\"point\",\"inputs\":{\"x\":0,\"y\":3.5,\"coordinateSpace\":\"world\"},\"outputs\":[\"I2y\"]},\n    {\"id\":\"kL1\",\"operator\":\"line\",\"inputs\":{\"start\":\"I1\",\"direction\":[0,1]},\"outputs\":[\"L1\"]},\n    {\"id\":\"kL2\",\"operator\":\"line\",\"inputs\":{\"start\":\"I2x\",\"end\":\"I2y\"},\"outputs\":[\"L2\"]},\n    {\"id\":\"kP\",\"operator\":\"intersection\",\"inputs\":{\"first\":\"L1\",\"second\":\"L2\"},\"outputs\":[\"P\"]}\n  ],\n  \"relations\": [],\n  \"assertions\": [\n    {\"id\":\"aI1\",\"predicate\":\"on\",\"entities\":[\"I1\",\"L1\"],\"expected\":true,\"severity\":\"fatal\"},\n    {\"id\":\"aI2x\",\"predicate\":\"on\",\"entities\":[\"I2x\",\"L2\"],\"expected\":true,\"severity\":\"fatal\"},\n    {\"id\":\"aI2y\",\"predicate\":\"on\",\"entities\":[\"I2y\",\"L2\"],\"expected\":true,\"severity\":\"fatal\"},\n    {\"id\":\"aP1\",\"predicate\":\"on\",\"entities\":[\"P\",\"L1\"],\"expected\":true,\"severity\":\"fatal\"},\n    {\"id\":\"aP2\",\"predicate\":\"on\",\"entities\":[\"P\",\"L2\"],\"expected\":true,\"severity\":\"fatal\"}\n  ],\n  \"annotations\": [\n    {\"id\":\"eq1\",\"kind\":\"label\",\"targetIds\":[\"L1\"],\"text\":\"L1: x=5/2\"},\n    {\"id\":\"eq2\",\"kind\":\"label\",\"targetIds\":[\"L2\"],\"text\":\"L2: y=x/2+7/2\"},\n    {\"id\":\"labI1\",\"kind\":\"label\",\"targetIds\":[\"I1\"],\"text\":\"(5/2,0)\",\"quantityId\":\"l1xi\"},\n    {\"id\":\"labI2x\",\"kind\":\"label\",\"targetIds\":[\"I2x\"],\"text\":\"(-7,0)\",\"quantityId\":\"l2xi\"},\n    {\"id\":\"labI2y\",\"kind\":\"label\",\"targetIds\":[\"I2y\"],\"text\":\"(0,7/2)\",\"quantityId\":\"l2yi\"},\n    {\"id\":\"labP\",\"kind\":\"label\",\"targetIds\":[\"P\"],\"text\":\"P=(5/2,19/4)\"},\n    {\"id\":\"solution\",\"kind\":\"narration\",\"targetIds\":[\"L1\",\"L2\",\"P\"],\"text\":\"L1 is vertical and L2 is nonvertical. They cross only at P, so the system has exactly one solution; L1 has no y-intercept.\",\"quantityId\":\"n\"}\n  ],\n  \"requiredEntityIds\": [\"ax\",\"I1\",\"I2x\",\"I2y\",\"L1\",\"L2\",\"P\"],\n  \"revealGroups\": [\n    {\"id\":\"setup\