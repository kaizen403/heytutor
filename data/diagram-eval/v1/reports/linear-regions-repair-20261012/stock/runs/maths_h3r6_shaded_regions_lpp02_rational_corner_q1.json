n\": \"Maximize Z = 5x + 4y over the shaded region.\"\n    },\n    {\n      \"id\": \"checkCorners\",\n      \"targetIds\": [\"feasible\"],\n      \"narration\": \"The exact feasible corners are (0,0), (5/2,0), (9/5,14/5), and (0,4). Their respective objective values are 0, 25/2, 101/5, and 16.\"\n    },\n    {\n      \"id\": \"identifyOptimum\",\n      \"targetIds\": [\"feasible\"],\n      \"narration\": \"The maximum is Z = 101/5 at the exact corner (9/5,14/5).\"\n    }\n  ]\n}"
