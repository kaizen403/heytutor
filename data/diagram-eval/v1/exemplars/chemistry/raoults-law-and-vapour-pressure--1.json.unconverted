    "annotations": [
      {
        "id": "figure_caption",
        "kind": "callout",
        "targetIds": [],
        "text": "Ideal solution of A and B: p_A = p°_A x_A and p_B = p°_B (1 minus x_A) are straight lines, and p_total = p_A + p_B runs from p°_B = 100 torr at pure B to p°_A = 200 torr at pure A. At x_A = 0.5: p_A = 100, p_B = 50, p_total = 150 torr; vapour mole fraction y_A = 0.667."
      }
