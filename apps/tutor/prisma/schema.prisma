generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  email                 String?            @unique
  name                  String?
  image                 String?
  emailVerified         DateTime?          @map("email_verified") @db.Timestamptz(6)
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at") @db.Timestamptz(6)
  examGoal              String?            @map("exam_goal")
  classYear             String?            @map("class_year")
  /// Set at onboarding: college student, or not.
  learnerRole           String?            @map("learner_role")
  subjects              String[]           @default([])
  locale                String             @default("en")
  ageBand               String?            @map("age_band")
  guardianEmail         String?            @map("guardian_email")
  guardianNotifiedAt    DateTime?          @map("guardian_notified_at") @db.Timestamptz(6)
  learningNote          String?            @map("learning_note")
  /// Fast UI cache only. Monthly millicents ledger is usage authority.
  planId                String?              @map("plan_id")
  remainingPct          Int?                 @map("remaining_pct")
  boards                Board[]
  turns                 Turn[]
  chatMessages          BoardChatMessage[]
  settings              UserSettings?
  periodSpend           BillingPeriodSpend[]

  @@map("users")
}

/// Staff who can open /admin and sign in with a personal Google account.
model Admin {
  email     String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admins")
}

/// Calendar-month USD spend (millicents) plus top-up allowance for that period.
model BillingPeriodSpend {
  userId           String   @map("user_id")
  period           String
  spentMillicents  Int      @default(0) @map("spent_millicents")
  bonusMillicents  Int      @default(0) @map("bonus_millicents")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, period])
  @@map("billing_period_spend")
}

model UserSettings {
  userId               String   @id @map("user_id")
  fastMode             Boolean  @default(true) @map("fast_mode")
  familiarity          String   @default("normal")
  audioLanguage        String   @default("english") @map("audio_language")
  accent               String   @default("india")
  narrationEnabled     Boolean  @default(true) @map("narration_enabled")
  lowLatencyVoice      Boolean  @default(false) @map("low_latency_voice")
  subtitlesEnabled     Boolean  @default(false) @map("subtitles_enabled")
  markerColor          String   @default("navy") @map("marker_color")
  /// Which marker stunts the student picked. Empty means the hand plays none.
  markerStunts         String[] @default(["thumbAround", "knuckleRoll", "helicopter", "tossCatch"]) @map("marker_stunts")
  /// Lecture download container. `mp4` unless the student picked `webm`.
  lectureFileType      String   @default("mp4") @map("lecture_file_type")
  speedMultiplier      Float    @default(1.5) @map("speed_multiplier")
  uiLanguage           String   @default("en") @map("ui_language")
  showHomeSuggestions  Boolean  @default(true) @map("show_home_suggestions")
  reducedMotion        Boolean  @default(false) @map("reduced_motion")
  teachingNote         String   @default("") @map("teaching_note")
  alwaysShowUnits      Boolean  @default(false) @map("always_show_units")
  alwaysStateLawFirst  Boolean  @default(false) @map("always_state_law_first")
  rememberWeakTopics   Boolean  @default(true) @map("remember_weak_topics")
  emailWeeklyRecap     Boolean  @default(false) @map("email_weekly_recap")
  emailGuardianNotice  Boolean  @default(true) @map("email_guardian_notice")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Board {
  id           String             @id
  userId       String             @map("user_id")
  title        String             @default("new board")
  preview      String             @default("")
  /// Pinned boards sort above the rest, newest pin first.
  pinnedAt     DateTime?          @map("pinned_at") @db.Timestamptz(6)
  /// Archived boards leave the list without being deleted.
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns        Turn[]
  chatMessages BoardChatMessage[]

  @@index([userId], map: "boards_user_id_idx")
  @@index([userId, archivedAt, pinnedAt], map: "boards_user_id_archived_at_pinned_at_idx")
  @@map("boards")
}

model BoardChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @map("board_id")
  userId    String   @map("user_id")
  role      String
  content   String
  /// Board line the student tagged when they sent this message (user rows only).
  tag       Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt], map: "board_chat_messages_board_id_created_at_idx")
  @@index([userId], map: "board_chat_messages_user_id_idx")
  @@map("board_chat_messages")
}

model Turn {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId            String    @map("board_id")
  userId             String    @map("user_id")
  orderIndex         Int       @map("order_index")
  question           String
  rawResponse        String    @map("raw_response")
  speedMultiplier    Float     @default(1) @map("speed_multiplier")
  traceId            String?   @map("trace_id")
  sceneDocument      Json?     @map("scene_document")
  sceneEngineVersion String?   @map("scene_engine_version")
  validationReport   Json?     @map("validation_report")
  visualStatus       String?   @map("visual_status")
  sceneArtifacts     Json?     @map("scene_artifacts")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  board              Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments           Segment[]

  @@unique([boardId, orderIndex], map: "turns_board_id_order_index_key")
  @@index([boardId], map: "turns_board_id_idx")
  @@index([userId], map: "turns_user_id_idx")
  @@index([createdAt], map: "turns_created_at_idx")
  @@map("turns")
}

model Segment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId      String   @map("turn_id") @db.Uuid
  orderIndex  Int      @map("order_index")
  narration   String   @default("")
  spokenText  String   @default("") @map("spoken_text")
  command     Json?
  audioUrl    String?  @map("audio_url")
  audioFormat String?  @default("audio/mpeg") @map("audio_format")
  durationMs  Int?     @map("duration_ms")
  timings     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  turn        Turn     @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId], map: "segments_turn_id_idx")
  @@map("segments")
}
