# Fireworks (LLM)
FIREWORKS_API_KEY=
# Planners (TurnPlan, scene, DSA). Problem IR has its own model below.
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3
# Problem IR only. Fast mode does not send this lane to Kimi K3 Fast.
FIREWORKS_PROBLEM_IR_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Spoken teaching and notes-chat. Must accept `thinking: disabled` â a planned
# turn asks for no reasoning, and a thinking-only model (any GLM 5.3) 400s.
FIREWORKS_TEACHING_MODEL=accounts/fireworks/models/kimi-k3
# Fast mode (on by default) uses Fireworks Fast serving per lane.
# Planner Fast: Kimi K3 Fast. Teaching Fast: Kimi K3 Fast.
# FIREWORKS_FAST_MODEL=accounts/fireworks/routers/kimi-k3-fast
# FIREWORKS_TEACHING_FAST_MODEL=accounts/fireworks/routers/kimi-k3-fast
# Optional. Image-question OCR only. Default is Qwen 3.7 Plus (cheapest Fireworks vision).
# FIREWORKS_VISION_MODEL=accounts/fireworks/models/qwen3p7-plus
# Notes-chat experiment. Leave unset to keep Kimi Fast and the whole board.
# cheap = DeepSeek Flash with bounded notes. shadow = Kimi, plus a recorded Jev opinion.
# jev = DeepSeek only when Jev explicitly chooses a straightforward explanation.
# TUTOR_NOTES_EVALUATION_MODE=off
# FIREWORKS_NOTES_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# AI_GATEWAY_API_KEY=
# TUTOR_EVALUATION_ZDR=1

# Speech providers (server-only). Both default to cartesia when omitted.
TTS_PROVIDER=cartesia
STT_PROVIDER=cartesia
CARTESIA_API_KEY=
# Optional: overrides Simi (formerly Indian Lady), the native Indian English default.
# CARTESIA_VOICE_ID=3b554273-4299-48b9-9aaf-eefd438e3941
# CARTESIA_VOICE_ID_EN_GB=
# CARTESIA_VOICE_ID_EN_US=
# CARTESIA_VOICE_ID_HI=
# CARTESIA_MODEL=sonic-3.6
# Optional alternative model for Settings > Response speed. Otherwise uses CARTESIA_MODEL.
# CARTESIA_LOW_LATENCY_MODEL=sonic-3.6
# Optional separate dictation key; otherwise uses CARTESIA_API_KEY.
# CARTESIA_STT_API_KEY=
# CARTESIA_STT_MODEL=ink-whisper
# Internal USD estimate, not a provider invoice. Set to your plan's effective rate.
CARTESIA_USD_PER_1K_CHARS=0.05

# ElevenLabs (retained; enable with TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
# Indian English (default). Saavi - en-IN, conversational.
# Every voice below is optional; an unset one falls back to this default.
ELEVENLABS_VOICE_ID=H8bdWZHK2OgZwTN7ponr
# Per-language/accent voices, chosen at request time from Settings
# (Audio Language + Accent). All verified on eleven_multilingual_v2.
# Hindi. Devi - hi-IN, informative_educational.
ELEVENLABS_VOICE_ID_HI=MF4J4IDTRo0AxOO4dpFR
# UK English. Alice - en-GB, informative_educational.
ELEVENLABS_VOICE_ID_EN_GB=Xb7hH8MSUJpSbSDYk0k2
# US English. Matilda - en-US, informative_educational.
ELEVENLABS_VOICE_ID_EN_US=XrExE9yKIg1WjnnlVkGX
# Optional. Default is eleven_multilingual_v2 (more expressive). Use eleven_flash_v2_5 for lowest latency.
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ElevenLabs (enable with STT_PROVIDER=elevenlabs)
# Deliberately its own key, not shared with ELEVENLABS_API_KEY above, so
# dictation and lesson narration can be pointed at different accounts, budgeted
# apart, or rotated without taking the other down. Unset falls back to the
# browser's own dictation where the browser has it.
ELEVENLABS_STT_API_KEY=
# Optional. Default is scribe_v1.
# ELEVENLABS_STT_MODEL=scribe_v1

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Public site URL (SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js — login is on unless AUTH_DISABLED=1. That hatch is ignored when
# NODE_ENV=production. Set both so the client SessionProvider matches.
# AUTH_DISABLED=1
# NEXT_PUBLIC_AUTH_DISABLED=1
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Optional. Defaults to NEXT_PUBLIC_SITE_URL / http://localhost:3000
# AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Extra staff emails (bypass the .edu/.ac student gate, can open /admin).
# Production admins live in the Postgres `admins` table; this is an emergency override.
# STAFF_EMAILS=you@gmail.com
# Magic-link email. Without this, the login page hides the email form.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Accelute <hi@accelute.co>
# Local-only bypass (never in production): shows "Continue as local student"
AUTH_DEV_LOGIN=1
# Extra staff emails for /admin (same as STAFF_EMAILS above)
# STAFF_EMAILS=you@accelute.co
# Optional. Legal links on the tutor point here.
# NEXT_PUBLIC_LANDING_URL=http://localhost:5173

# Postgres (lecture persistence)
# Local dev: pnpm db:up && pnpm --filter @heytutor/tutor db:migrate
# Production: managed Postgres URL (RDS). Do not run Docker Postgres on the app box.
DATABASE_URL=postgresql://heytutor:heytutor@localhost:5433/heytutor

# S3 (lecture MP3/WAV audio + question photos). Prefer an EC2 instance role; keys are optional.
# AWS_REGION=ap-south-2
# S3_BUCKET=heytutor-lectures
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional. Only if objects are public (not the default). Private buckets are served via /api/media.
# S3_PUBLIC_BASE_URL=
# Optional custom endpoint (S3-compatible). Leave unset for AWS S3.
# S3_ENDPOINT=

# Short-lived /api/tts/ws tickets. Required in production.
# Generate: openssl rand -base64 32
WS_TICKET_SECRET=

# Shared secret for lecture-lab spend bypass. Header value must match.
# Required for `scripts/lecture-lab/*` against a running tutor.
# Generate: openssl rand -hex 32
# LECTURE_LAB_TOKEN=

# Autumn billing. Production enables checkout when AUTUMN_SECRET_KEY is set,
# unless AUTUMN_ENABLED=0. Local/dev stays off unless AUTUMN_ENABLED=1 and the
# secret is set. Teaching uses the local USD ledger either way — a missing
# secret must not 503 lessons. Local fuses always stay on.
# STAFF_EMAILS (above) skip Autumn checks and local fuses.
# AUTUMN_ENABLED=0
# AUTUMN_SECRET_KEY=am_sk_...
# AUTUMN_WEBHOOK_SECRET=whsec_...
# Per-model Langfuse / daily-USD rates (defaults match Fireworks serverless).
# FIREWORKS_KIMI_FAST_INPUT_USD_PER_1M=4.5
# FIREWORKS_KIMI_FAST_OUTPUT_USD_PER_1M=22.5
# FIREWORKS_KIMI_K3_INPUT_USD_PER_1M=3
# FIREWORKS_KIMI_K3_OUTPUT_USD_PER_1M=15
# FIREWORKS_DEEPSEEK_FLASH_INPUT_USD_PER_1M=0.22
# FIREWORKS_DEEPSEEK_FLASH_OUTPUT_USD_PER_1M=0.66
# FIREWORKS_VISION_INPUT_USD_PER_1M=0.5
# FIREWORKS_VISION_OUTPUT_USD_PER_1M=3
# ELEVENLABS_USD_PER_1K_CHARS=0.10
# Optional per-model overrides. Defaults match ElevenLabs API:
# Flash/Turbo $0.05 / 1k chars, Multilingual v2/v3 $0.10 / 1k chars.
# ELEVENLABS_FLASH_USD_PER_1K_CHARS=0.05
# ELEVENLABS_MULTILINGUAL_USD_PER_1K_CHARS=0.10
