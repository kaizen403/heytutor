# Fireworks (LLM)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
# Optional. Used instead of FIREWORKS_MODEL when Fast mode is on.
# FIREWORKS_FAST_MODEL=
# Optional. Image-question OCR only. Default is Qwen 3.7 Plus (cheapest Fireworks vision).
# FIREWORKS_VISION_MODEL=accounts/fireworks/models/qwen3p7-plus

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Default is eleven_multilingual_v2 (more expressive). Use eleven_flash_v2_5 for lowest latency.
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Public site URL (SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (lecture persistence)
# Local dev: pnpm db:up && pnpm --filter @heytutor/tutor db:migrate
DATABASE_URL=postgresql://heytutor:heytutor@localhost:5433/heytutor

# Cloudflare R2 (lecture audio)
# Provision: pnpm r2:setup  |  Auth: wrangler login  |  Uploads: wrangler r2 object put
# Values below are placeholders. Real IDs go only in .env.local (gitignored).
R2_ACCOUNT_ID=
R2_BUCKET=heytutor-lectures
R2_PUBLIC_BASE_URL=
