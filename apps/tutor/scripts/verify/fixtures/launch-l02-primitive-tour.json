    "annotations": [
      {
        "id": "aKinetic",
        "kind": "narration",
        "text": "A moving mass has kinetic energy: E_k = ½mv², where v is its speed.",
        "targetIds": [
          "mass"
        ]
      },
      {
        "id": "aPotential",
        "kind": "narration",
        "text": "Displacing the ideal spring from equilibrium stores elastic potential energy: E_s = ½kx².",
        "targetIds": [
          "spring",
          "displacement"
        ]
      },
      {
        "id": "aExchange",
        "kind": "narration",
        "text": "At maximum displacement the mass is momentarily still: spring potential energy is greatest and kinetic energy is zero. Moving toward equilibrium converts potential energy to kinetic energy; at equilibrium speed and kinetic energy are greatest.",
        "targetIds": [
          "mass",
          "spring",
          "equilibrium"
        ]
      },
      {
        "id": "aConservation",
        "kind": "narration",
        "text": "Without friction or other energy losses, E_k + E_s remains constant.",
        "targetIds": [
          "mass",
          "spring"
        ]
      }
    ],
