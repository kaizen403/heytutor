{"schemaVersion":"turn-plan/v3","question":"A car moving at 20 m/s brakes uniformly to rest in 5 s. Find its acceleration and the distance travelled while braking.","givens":[{"id":"u","symbol":"u","value":20,"unit":"m/s","sign":"+","sourceText":"moving at 20 m/s","provenance":"given"},{"id":"v","symbol":"v","value":0,"unit":"m/s","sign":"+","sourceText":"brakes uniformly to rest","provenance":"given"},{"id":"t","symbol":"t","value":5,"unit":"s","sign":"+","sourceText":"in 5 s","provenance":"given"}],"unknowns":[{"id":"a","symbol":"a","unit":"m/s^2"},{"id":"s","symbol":"s","unit":"m"}],"derived":[{"id":"a","symbol":"a","value":-4,"unit":"m/s^2","sign":"-","sourceText":"a=(v-u)/t=(0-20)/5=-4","provenance":"derived","dependsOn":["u","v","t"]},{"id":"s","symbol":"s","value":50,"unit":"m","sign":"+","sourceText":"s=(u+v)/2*t=(20+0)/2*5=50","provenance":"derived","dependsOn":["u","v","t"]}],"qualitativeClaims":[{"id":"c1","claim":"Acceleration is opposite to motion (deceleration of magnitude 4 m/s^2).","expected":"a=-4 m/s^2","relatedQuantityIds":["a","u","v","t"]},{"id":"c2","claim":"Distance equals average velocity times time under uniform acceleration.","expected":"s=((u+v)/2)t=50 m","relatedQuantityIds":["s","u","v","t"]}],"lawIds":["kinematics_uniform_acceleration","v=u+at","s=(u+v)t/2"],"assumptions":["uniform (constant) acceleration","straight-line motion","initial direction taken as positive"],"visualRequirement":"optional"}