  {
    "id": "CHEM_H80_XI_003",
    "round": 1,
    "question": "A collimated beam of positively charged \u03b1 particles strikes a very thin gold foil. Draw the experiment and an enlarged schematic of trajectories near one gold nucleus. Show why most \u03b1 particles pass almost straight through, some are deflected, and a very small number return toward the source. Mark the relative source, foil, and detector positions; the enlargement need not be to scale.",
    "plan": {
      "visualRequirement": "required",
      "requiresVisualByStem": true,
      "givens": [],
      "unknowns": [],
      "derived": [],
      "qualitativeClaims": [
        {
          "id": "layout",
          "expected": "Place the \u03b1 source before the thin gold foil, with its collimated beam directed toward the foil. Show a detector at positions around the foil to register transmitted, deflected, and source-side returning particles."
        },
        {
          "id": "straight",
          "expected": "In the enlargement, show most trajectories crossing the foil far from a nucleus with little change in direction: atoms are mostly empty space, and strong encounters with their tiny nuclei are uncommon."
        },
        {
          "id": "deflected",
          "expected": "Show trajectories passing near a positively charged nucleus bending away from it because the positively charged \u03b1 particle experiences electrostatic repulsion."
        },
        {
          "id": "return",
          "expected": "Show a rare, nearly head-on approach to a nucleus turning back under strong electrostatic repulsion; such close approaches are rare because the nucleus is tiny."
        }
      ],
      "lawIds": [
        "Coulomb's law",
        "Rutherford nuclear model"
      ],
      "assumptions": []
    },
    "candidate": null
  },
