  {
    "id": "CHEM_H80_XI_003",
    "round": 2,
    "question": "A collimated beam of positively charged \u03b1 particles strikes a very thin gold foil. Draw the experiment and an enlarged schematic of trajectories near one gold nucleus. Show why most \u03b1 particles pass almost straight through, some are deflected, and a very small number return toward the source. Mark the relative source, foil, and detector positions; the enlargement need not be to scale.",
    "plan": {
      "visualRequirement": "required",
      "requiresVisualByStem": true,
      "givens": [],
      "unknowns": [],
      "derived": [],
      "qualitativeClaims": [
        {
          "id": "c1",
          "expected": "The collimated \u03b1 source faces the thin gold foil. A detector can register particles beyond the foil at different angles and on the source side for particles that return."
        },
        {
          "id": "c2",
          "expected": "The positive nucleus occupies a tiny region of each atom, so most \u03b1 particles pass far from nuclei and experience little deflection."
        },
        {
          "id": "c3",
          "expected": "A positively charged \u03b1 particle passing near a positively charged nucleus is repelled; its trajectory bends away from the nucleus."
        },
        {
          "id": "c4",
          "expected": "An \u03b1 particle approaching a nucleus nearly head-on can be strongly repelled and reverse direction. Such close approaches are rare because the nucleus is very small."
        },
        {
          "id": "c5",
          "expected": "Show a central positive gold nucleus with a distant, nearly straight path, a closer path bending away, and a nearly head-on path turning back toward the incident side. The enlargement need not be to scale."
        }
      ],
      "lawIds": [
        "Coulomb repulsion of like charges",
        "Rutherford nuclear model"
      ],
      "assumptions": []
    },
    "candidate": null
  },
