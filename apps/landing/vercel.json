{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@heytutor/landing...",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/about/", "destination": "/about.html" },
    { "source": "/ai-whiteboard", "destination": "/ai-whiteboard.html" },
    { "source": "/ai-whiteboard/", "destination": "/ai-whiteboard.html" },
    { "source": "/ai-tutor", "destination": "/ai-tutor.html" },
    { "source": "/ai-tutor/", "destination": "/ai-tutor.html" },
    { "source": "/ai-study", "destination": "/ai-study.html" },
    { "source": "/ai-study/", "destination": "/ai-study.html" }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.accelute.co/login?google=1",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://app.accelute.co/:path*",
      "permanent": false
    }
  ],
  "regions": ["bom1"]
}
