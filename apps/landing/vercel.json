{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@heytutor/landing...",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://heytutor.vercel.app",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://heytutor.vercel.app/:path*",
      "permanent": false
    }
  ],
  "regions": ["bom1"]
}
