      "id": "mechanics-easy-incline-force",
      "priority": "p0",
      "domain": "mechanics",
      "difficulty": "easy",
      "question": "A 5 kg block rests on a rough horizontal floor. A 20 N force is applied at 37 degrees above the horizontal. If the coefficient of kinetic friction is 0.20 and g = 10 m/s^2, draw the free-body diagram and find the normal reaction, friction, and acceleration.",
      "visualRequirement": "required",
      "representations": ["free_body_diagram"],
      "expected": {
        "quantities": [
          { "id": "normal", "value": 38, "unit": "N", "tolerance": 0.01 },
          { "id": "friction", "value": 7.6, "unit": "N", "tolerance": 0.01 },
          { "id": "acceleration", "value": 1.68, "unit": "m/s^2", "tolerance": 0.01 }
