      "capabilities": {
        "operators": ["rectangle", "vector", "vector_components", "dimension", "label"],
        "assertions": ["perpendicular", "opposite_direction", "connected"],
        "missingProofs": ["vector_sum", "quantity_equation", "force_attached_to_body"]
      }
    },
