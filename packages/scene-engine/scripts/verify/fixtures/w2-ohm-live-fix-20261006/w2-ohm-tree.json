    "qualitativeClaims": [
      {
        "id": "c1",
        "claim": "The 6 Ω and 3 Ω resistors in parallel give an equivalent resistance of 2 Ω, less than either branch.",
        "expected": "R_p = (R₂·R₃)/(R₂+R₃) = 2 Ω",
        "relatedQuantityIds": [
          "Rp",
          "R2",
          "R3"
        ]
      },
      {
        "id": "c2",
        "claim": "The series 3 Ω resistor adds to the parallel combination, giving total resistance 5 Ω.",
        "expected": "R_t = R₁ + R_p = 5 Ω",
        "relatedQuantityIds": [
          "Rt",
          "R1",
          "Rp"
        ]
      },
      {
        "id": "c3",
        "claim": "By Ohm's law the battery current equals the battery voltage divided by the total equivalent resistance.",
        "expected": "I = V/R_t = 2 A",
        "relatedQuantityIds": [
          "I",
          "V",
          "Rt"
        ]
      }
